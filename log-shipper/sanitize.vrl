# Only this fresh object can leave the process boundary. No envelope, span,
# message, error, identity, URI or unknown key is copied into it.
j = .parsed
label = .label
out = {}
ts = ""
if label == "tinycloud-node" {
  target = string(j.target) ?? ""
  level = downcase(string!(j.level))
  f = object(j.fields) ?? {}
  msg = string(f.message) ?? ""
  ts = string!(j.timestamp)
  # Literal Rocket template aliases only; never split an arbitrary URI.
  aliases = __ROUTE_ALIASES__
  # TC-1840: the node's one 5xx diagnostic line per database failure ships as an individual event.
  # The input must carry exactly the declared keys (the message plus these seven, and db_hash only
  # when it is a valid pseudonym) with exactly the declared types and enum values. Anything else
  # leaves db_event null and the line falls back to the unclassified count below; no value of it
  # is ever copied unless it passed, and the shipped object is built from literals and the
  # validated values only.
  db_event = null
  if target == "tinycloud::request" && level == "warn" && msg == "database failure answered with a 5xx" {
    db_status = f.status
    db_elapsed = f.elapsed_ms
    db_code = string(f.code) ?? ""
    db_service = string(f.service) ?? ""
    db_kind = string(f.failure_kind) ?? ""
    db_route = string(f.route) ?? ""
    db_canonical_route = get(aliases, [db_route]) ?? null
    if is_string(db_canonical_route) { db_route = db_canonical_route }
    db_ok = is_integer(db_status) && is_integer(db_elapsed) && is_boolean(f.write_may_have_applied)
    if db_ok {
      db_status = int!(db_status)
      db_elapsed = int!(db_elapsed)
      db_ok = db_status >= 500 && db_status <= 599 && db_elapsed >= 0 && db_elapsed <= 9007199254740991 && includes(__DB_FAILURE_CODES__, db_code) && includes(__DB_FAILURE_SERVICES__, db_service) && includes(__DB_FAILURE_KINDS__, db_kind) && includes(__ROUTES__, db_route)
    }
    db_hash = string(f.db_hash) ?? ""
    has_db_hash = exists(f.db_hash)
    if db_ok {
      if has_db_hash { db_ok = match(db_hash, r'^[0-9a-f]{64}$') && length(f) == 9 } else { db_ok = length(f) == 8 }
    }
    if db_ok {
      db_event = {"event": "node_warning", "svc": "api", "level": "warn", "event_code": "db_failure_5xx", "status": db_status, "code": db_code, "service": db_service, "route": db_route, "elapsed_ms": db_elapsed, "failure_kind": db_kind, "write_may_have_applied": bool!(f.write_may_have_applied)}
      if has_db_hash { db_event.db_hash = db_hash }
    }
  }
  # TC-2076: the node's slow chain-guard wait warning (at most one per second per process) ships as an individual
  # event. The input must carry exactly the declared keys (the message, event and the four fields) with the
  # declared types, enum value and ranges. Anything else leaves chain_event null and the line falls back to the
  # unclassified count below; the shipped object is built from literals and the validated values only.
  chain_event = null
  if target == "tinycloud::chain_guard" && level == "warn" && msg == "chain guard wait exceeded the slow-wait threshold" && f.event == "chain_guard_slow_wait" {
    chain_kind = string(f.kind) ?? ""
    chain_elapsed = f.elapsed_ms
    chain_guards = f.guards
    chain_suppressed = f.suppressed
    chain_ok = length(f) == 6 && includes(__CHAIN_GUARD_KINDS__, chain_kind) && is_integer(chain_elapsed) && is_integer(chain_guards) && is_integer(chain_suppressed)
    if chain_ok {
      chain_elapsed = int!(chain_elapsed)
      chain_guards = int!(chain_guards)
      chain_suppressed = int!(chain_suppressed)
      chain_ok = chain_elapsed >= 0 && chain_elapsed <= 9007199254740991 && chain_guards >= 0 && chain_guards <= __CHAIN_GUARDS_MAX__ && chain_suppressed >= 0 && chain_suppressed <= __CHAIN_SUPPRESSED_MAX__
    }
    if chain_ok {
      chain_event = {"event": "node_warning", "svc": "api", "level": "warn", "event_code": "chain_guard_slow_wait", "kind": chain_kind, "elapsed_ms": chain_elapsed, "guards": chain_guards, "suppressed": chain_suppressed}
    }
  }
  if target == "tinycloud::request" && level == "info" && msg == "request" {
    method = string!(f.method)
    if includes(["TRACE", "CONNECT"], method) { method = "<other>" }
    route = string!(f.route)
    canonical_route = get(aliases, [route]) ?? null
    if is_string(canonical_route) { route = canonical_route }
    if !includes(__METHODS__, method) || !includes(__ROUTES__, route) { abort }
    status = f.status
    latency = f.latency_us
    if !is_integer(status) || !is_integer(latency) { abort }
    status = int!(status)
    latency = int!(latency)
    if status < 100 || status > 599 || latency < 0 || latency > 9007199254740991 { abort }
    out = {"event": "node_request", "svc": "api", "level": "info", "method": method, "route": route, "status": status, "latency_us": latency}
    # N2 correlation fields: copied only when they have exactly the node's emitted shape; anything else is dropped
    # (the event still ships). The pseudonyms are keyed HMAC-SHA256 digests, never raw identifiers.
    rid = string(f.request_id) ?? ""
    if match(rid, r'^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') { out.request_id = rid }
    replaced = f.request_id_replaced
    if is_boolean(replaced) { out.request_id_replaced = replaced }
    account = string(f.account_hash) ?? ""
    if match(account, r'^[0-9a-f]{64}$') { out.account_hash = account }
    space = string(f.space_hash) ?? ""
    if match(space, r'^[0-9a-f]{64}$') { out.space_hash = space }
  } else if is_object(db_event) {
    out = db_event
  } else if is_object(chain_event) {
    out = chain_event
  } else {
    if !includes(["warn", "error"], level) { abort }
    code = "unclassified"
    if target == "tinycloud" || starts_with(target, "tinycloud::") || target == "tinycloud_core" || starts_with(target, "tinycloud_core::") {
      codes = __DIAGNOSTICS__
      known = get(codes, [msg]) ?? null
      if is_string(known) { code = known }
      __PREFIX_DIAGNOSTICS__
    }
    event = if level == "warn" { "node_warning" } else { "node_error" }
    out = {"event": event, "svc": "api", "level": level, "event_code": code, "event_count": 1}
  }
} else {
  ts = string!(j.time)
  method = string!(j.method)
  route = string!(j.route)
  if route == "<other>" { route = "<unmatched>" }
  if !includes(__METHODS__, method) || !includes(__ROUTES__, route) { abort }
  status = j.status
  request_time = j.request_time
  if !is_integer(status) || !(is_integer(request_time) || is_float(request_time)) { abort }
  status = int!(status)
  request_time = to_float!(request_time)
  if status < 100 || status > 599 || request_time < 0 || request_time > 86400 { abort }
  out = {"event": "ingress_request", "svc": "ingress", "level": "info", "method": method, "route": route, "status": status, "request_time_seconds": request_time}
}
if length(ts) > 64 { abort }
parsed_ts = parse_timestamp!(ts, format: "%+")
out.ts = format_timestamp!(parsed_ts, format: "%Y-%m-%dT%H:%M:%S%.3fZ")
. = out

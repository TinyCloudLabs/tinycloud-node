# Only this fresh object can leave the process boundary. No envelope, span,
# message, error, identity, URI or unknown key is copied into it.
j = .parsed
label = .label
out = {}
ts = ""
if label == "tinycloud-node" {
  target = string(j.target) ?? ""
  level = downcase(string!(j.level))
  f = object(j.fields) ?? {}
  msg = string(f.message) ?? ""
  ts = string!(j.timestamp)
  # Literal Rocket template aliases only; never split an arbitrary URI.
  aliases = __ROUTE_ALIASES__
  # TC-1840: the node's one 5xx diagnostic line per database failure ships as an individual event.
  # The input must carry exactly the declared keys (the message plus these seven, and db_hash only
  # when it is a valid pseudonym) with exactly the declared types and enum values. Anything else
  # leaves db_event null and the line falls back to the unclassified count below; no value of it
  # is ever copied unless it passed, and the shipped object is built from literals and the
  # validated values only.
  db_event = null
  if target == "tinycloud::request" && level == "warn" && msg == "database failure answered with a 5xx" {
    db_status = f.status
    db_elapsed = f.elapsed_ms
    db_code = string(f.code) ?? ""
    db_service = string(f.service) ?? ""
    db_kind = string(f.failure_kind) ?? ""
    db_route = string(f.route) ?? ""
    db_canonical_route = get(aliases, [db_route]) ?? null
    if is_string(db_canonical_route) { db_route = db_canonical_route }
    db_ok = is_integer(db_status) && is_integer(db_elapsed) && is_boolean(f.write_may_have_applied)
    if db_ok {
      db_status = int!(db_status)
      db_elapsed = int!(db_elapsed)
      db_ok = db_status >= 500 && db_status <= 599 && db_elapsed >= 0 && db_elapsed <= 9007199254740991 && includes(__DB_FAILURE_CODES__, db_code) && includes(__DB_FAILURE_SERVICES__, db_service) && includes(__DB_FAILURE_KINDS__, db_kind) && includes(__ROUTES__, db_route)
    }
    db_hash = string(f.db_hash) ?? ""
    has_db_hash = exists(f.db_hash)
    if db_ok {
      if has_db_hash { db_ok = match(db_hash, r'^[0-9a-f]{64}$') && length(f) == 9 } else { db_ok = length(f) == 8 }
    }
    if db_ok {
      db_event = {"event": "node_warning", "svc": "api", "level": "warn", "event_code": "db_failure_5xx", "status": db_status, "code": db_code, "service": db_service, "route": db_route, "elapsed_ms": db_elapsed, "failure_kind": db_kind, "write_may_have_applied": bool!(f.write_may_have_applied)}
      if has_db_hash { db_event.db_hash = db_hash }
    }
  }
  # TC-2917: the node's periodic disk headroom line (one per local store) ships as an individual
  # info event. Exactly the message plus `store` (a declared store) and `free_bytes` (a bounded
  # integer in whole 64 MiB steps, as the node rounds it); anything else leaves headroom null, and
  # the info line is then dropped below.
  headroom = null
  if target == "tinycloud::disk_headroom" && level == "info" && msg == "storage headroom" && length(f) == 3 {
    h_store = string(f.store) ?? ""
    h_free = f.free_bytes
    if includes(__STORAGE_STORES__, h_store) && is_integer(h_free) {
      h_free = int!(h_free)
      if h_free >= 0 && h_free <= 9007199254740991 && mod(h_free, 67108864) == 0 {
        headroom = {"event": "node_storage_headroom", "svc": "api", "level": "info", "store": h_store, "free_bytes": h_free}
      }
    }
  }
  # TC-3216: the node's three fair-share report lines (`tinycloud::fair_share`, each at most once a minute) ship as
  # individual events. The input must carry exactly the declared keys (the message, `event` and the line's fields) with
  # exactly the declared types, enum values and bounds; account fields are copied only as 64-hex pseudonyms, and a rank
  # or top account the node reports as absent (empty pseudonym, zero counts) is omitted. Anything else leaves fair null
  # and the line falls back to the unclassified count below; the shipped object is built from literals and validated
  # values only.
  fair = null
  if target == "tinycloud::fair_share" && level == "warn" && is_integer(f.window_s) && f.window_s == 60 {
    fair_event = string(f.event) ?? ""
    fair_limit_line = msg == "invocations over a per-account limit" && fair_event == "account_limited" && length(f) == 9
    fair_rate_line = msg == "invocations over the per-invoker rate limit" && fair_event == "invoke_rate_limited" && length(f) == 8
    if fair_limit_line || fair_rate_line {
      fair_mode = string(f.mode) ?? ""
      fair_limit = string(f.limit) ?? ""
      fair_hash = string(f.top_account_hash) ?? "-"
      fair_ok = includes(__FAIR_SHARE_MODES__, fair_mode) && is_integer(f.count) && is_integer(f.accounts) && is_integer(f.top_account_count)
      if fair_ok && fair_limit_line { fair_ok = includes(__FAIR_SHARE_LIMITS__, fair_limit) }
      fair_count = int(f.count) ?? 0
      fair_accounts = int(f.accounts) ?? -1
      fair_top_count = int(f.top_account_count) ?? -1
      if fair_ok {
        fair_ok = fair_count >= 1 && fair_count <= 9007199254740991 && fair_accounts >= 0 && fair_accounts <= 9007199254740991 && fair_top_count >= 0 && fair_top_count <= 9007199254740991
      }
      fair_has_top = fair_hash != ""
      if fair_ok {
        if fair_has_top { fair_ok = match(fair_hash, r'^[0-9a-f]{64}$') && fair_top_count >= 1 } else { fair_ok = fair_top_count == 0 }
      }
      if fair_ok {
        fair = {"event": "node_warning", "svc": "api", "level": "warn", "event_code": fair_event, "mode": fair_mode, "count": fair_count, "accounts": fair_accounts, "window_s": 60}
        if fair_limit_line { fair.limit = fair_limit }
        if fair_has_top {
          fair.top_account_hash = fair_hash
          fair.top_account_count = fair_top_count
        }
      }
    } else if msg == "accounts with the most database time" && fair_event == "node_top_talkers" && length(f) == 19 {
      fair_ok = is_integer(f.db_ms) && is_integer(f.requests) && is_integer(f.unattributed_db_ms) && is_integer(f.accounts)
      talkers = {}
      for_each(["db_ms", "requests", "unattributed_db_ms", "accounts"]) -> |_index, key| {
        value = int(get(f, [key]) ?? null) ?? -1
        if value < 0 || value > 9007199254740991 { fair_ok = false }
        talkers = set!(talkers, [key], value)
      }
      for_each(["1", "2", "3"]) -> |_index, rank| {
        prefix = "top" + rank + "_"
        rank_hash = string(get(f, [prefix + "account_hash"]) ?? null) ?? "-"
        rank_db_ms = int(get(f, [prefix + "db_ms"]) ?? null) ?? -1
        rank_requests = int(get(f, [prefix + "requests"]) ?? null) ?? -1
        rank_share_value = get(f, [prefix + "share"]) ?? null
        rank_share = -1.0
        if is_float(rank_share_value) || is_integer(rank_share_value) { rank_share = to_float(rank_share_value) ?? -1.0 }
        if rank_db_ms < 0 || rank_db_ms > 9007199254740991 || rank_requests < 0 || rank_requests > 9007199254740991 || rank_share < 0.0 || rank_share > 1.0 {
          fair_ok = false
        } else if rank_hash == "" {
          if rank_db_ms != 0 || rank_requests != 0 || rank_share != 0.0 { fair_ok = false }
        } else if match(rank_hash, r'^[0-9a-f]{64}$') {
          talkers = set!(talkers, [prefix + "account_hash"], rank_hash)
          talkers = set!(talkers, [prefix + "db_ms"], rank_db_ms)
          talkers = set!(talkers, [prefix + "requests"], rank_requests)
          talkers = set!(talkers, [prefix + "share"], rank_share)
        } else {
          fair_ok = false
        }
      }
      if fair_ok {
        fair = merge({"event": "node_warning", "svc": "api", "level": "warn", "event_code": "node_top_talkers", "window_s": 60}, talkers)
      }
    }
  }
  if target == "tinycloud::request" && level == "info" && msg == "request" {
    method = string!(f.method)
    if includes(["TRACE", "CONNECT"], method) { method = "<other>" }
    route = string!(f.route)
    canonical_route = get(aliases, [route]) ?? null
    if is_string(canonical_route) { route = canonical_route }
    if !includes(__METHODS__, method) || !includes(__ROUTES__, route) { abort }
    status = f.status
    latency = f.latency_us
    if !is_integer(status) || !is_integer(latency) { abort }
    status = int!(status)
    latency = int!(latency)
    if status < 100 || status > 599 || latency < 0 || latency > 9007199254740991 { abort }
    out = {"event": "node_request", "svc": "api", "level": "info", "method": method, "route": route, "status": status, "latency_us": latency}
    # N2 correlation fields: copied only when they have exactly the node's emitted shape; anything else is dropped
    # (the event still ships). The pseudonyms are keyed HMAC-SHA256 digests, never raw identifiers.
    rid = string(f.request_id) ?? ""
    if match(rid, r'^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') { out.request_id = rid }
    replaced = f.request_id_replaced
    if is_boolean(replaced) { out.request_id_replaced = replaced }
    account = string(f.account_hash) ?? ""
    if match(account, r'^[0-9a-f]{64}$') { out.account_hash = account }
    space = string(f.space_hash) ?? ""
    if match(space, r'^[0-9a-f]{64}$') { out.space_hash = space }
  } else if is_object(db_event) {
    out = db_event
  } else if is_object(headroom) {
    out = headroom
  } else if is_object(fair) {
    out = fair
  } else {
    if !includes(["warn", "error"], level) { abort }
    code = "unclassified"
    if target == "tinycloud" || starts_with(target, "tinycloud::") || target == "tinycloud_core" || starts_with(target, "tinycloud_core::") {
      codes = __DIAGNOSTICS__
      known = get(codes, [msg]) ?? null
      if is_string(known) { code = known }
      __PREFIX_DIAGNOSTICS__
    }
    event = if level == "warn" { "node_warning" } else { "node_error" }
    out = {"event": event, "svc": "api", "level": level, "event_code": code, "event_count": 1}
  }
} else {
  ts = string!(j.time)
  method = string!(j.method)
  route = string!(j.route)
  if route == "<other>" { route = "<unmatched>" }
  if !includes(__METHODS__, method) || !includes(__ROUTES__, route) { abort }
  status = j.status
  request_time = j.request_time
  if !is_integer(status) || !(is_integer(request_time) || is_float(request_time)) { abort }
  status = int!(status)
  request_time = to_float!(request_time)
  if status < 100 || status > 599 || request_time < 0 || request_time > 86400 { abort }
  out = {"event": "ingress_request", "svc": "ingress", "level": "info", "method": method, "route": route, "status": status, "request_time_seconds": request_time}
}
if length(ts) > 64 { abort }
parsed_ts = parse_timestamp!(ts, format: "%+")
out.ts = format_timestamp!(parsed_ts, format: "%Y-%m-%dT%H:%M:%S%.3fZ")
. = out

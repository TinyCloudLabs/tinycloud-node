{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "write-probe.ts",
    "probe-core.ts",
    "probe-core.test.ts",
    "db-saturation.ts",
    "db-saturation-run.ts",
    "db-saturation.test.ts",
    "personal-node-check.ts"
  ]
}
